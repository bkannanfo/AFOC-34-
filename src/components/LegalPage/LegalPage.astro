---
import siteData from '../../data/site.json';
import PageHero from '../Page/PageHero.astro';

// Props : type ('mentionsLegales' | 'politiqueConfidentialite' | 'politiqueCookies').
// Chaque section : sectionTitle, text (chaîne ou liste), list?, after (chaîne ou liste).
const { type } = Astro.props;
const legalPage = siteData.legal[type];

if (!legalPage) {
  throw new Error(`Type légal invalide : ${type}`);
}

const asParagraphs = (value) => (!value ? [] : Array.isArray(value) ? value : [value]);
---

<PageHero eyebrow="Informations légales" title={legalPage.title} />

<section class="section">
  <div class="site-wrap legal-wrap">
    {
      legalPage.content.map((section) => (
        <section class="legal-item">
          <h2>{section.sectionTitle}</h2>
          <div class="legal-text">
            {asParagraphs(section.text).map((p) => (
              <p>{p}</p>
            ))}
            {section.list && (
              <ul>
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {asParagraphs(section.after).map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</section>

<style>
  .legal-wrap {
    border-top: 1px solid var(--color-line);
  }
  .legal-item {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 12px 40px;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-line);
  }
  h2 {
    font: 500 24px/1.2 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .legal-text {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-ink-soft);
    overflow-wrap: anywhere;
  }
  .legal-text p {
    margin: 0 0 12px;
  }
  .legal-text p:last-child {
    margin-bottom: 0;
  }
  .legal-text ul {
    margin: 0 0 12px;
    padding-left: 20px;
  }
  .legal-text li {
    margin-bottom: 6px;
  }
  .legal-text li::marker {
    color: var(--color-coral);
  }
  @media (max-width: 900px) {
    .legal-item {
      grid-template-columns: 1fr;
    }
  }
</style>
