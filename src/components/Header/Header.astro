---
import siteData from '../../data/site.json';
import { trackHref } from '../../data/tracking.js';
import logo from '../../../public/img/logo.jpg';
const { navLinks } = siteData.header;
const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="mast">
  <div class="site-wrap mast-inner">
    <a class="brand" href="/">
      <img src={logo.src} width="80" height="40" alt="" class="brand-logo" />
      <span class="brand-label"><b>AFOC 34</b>Hérault</span>
      <span class="visually-hidden">, accueil</span>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {
        navLinks.map((link) => (
          <a
            href={link.url}
            class:list={[link.cta && 'nav-cta']}
            {...trackHref(link.url, 'header')}
            aria-current={link.url === currentPath ? 'page' : undefined}
          >
            {link.name}
            {link.cta && <span aria-hidden="true"> →</span>}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .mast {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-text);
  }
  .mast-inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    flex-shrink: 0;
    color: var(--color-ink);
  }
  .brand-logo {
    /* fond blanc du JPG fondu dans le fond crème */
    mix-blend-mode: multiply;
    display: block;
    width: 80px;
    height: 40px;
  }
  .brand-label {
    border-left: 1px solid var(--color-line);
    padding-left: 15px;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .brand-label b {
    display: block;
    font-size: 14px;
    letter-spacing: 0.1em;
    margin-bottom: 3px;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px clamp(14px, 2vw, 26px);
  }
  .nav a {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink-soft);
    text-decoration: none;
    padding: 6px 0;
  }
  .nav a[aria-current='page'] {
    color: var(--color-teal);
    text-decoration: underline;
    text-decoration-color: var(--color-coral);
    text-underline-offset: 6px;
  }
  .nav a:hover {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .nav .nav-cta {
    border: 1px solid var(--color-border-strong);
    padding: 10px 15px;
    background: var(--color-white);
    color: var(--color-teal);
  }
  .nav .nav-cta:hover {
    background: var(--color-teal-tint);
    border-color: var(--color-teal);
    text-decoration: none;
  }
  @media (max-width: 720px) {
    .mast-inner {
      flex-wrap: wrap;
      gap: 0;
      padding: 14px 0;
    }
    .nav {
      width: 100%;
      justify-content: flex-start;
      gap: 4px 18px;
      padding-top: 12px;
    }
  }
</style>
