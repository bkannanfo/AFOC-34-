---
import siteData from '../../data/site.json';
import logo from '../../../public/img/logo.jpg';
---

<footer class="site-footer">
  <div class="site-wrap footer-inner">
    <div class="footid">
      <div class="footbrand">
        <img src={logo.src} width="64" height="32" alt="Logo AFOC" />
        <span>AFOC 34 · Association Force Ouvrière Consommateurs de l'Hérault</span>
      </div>
      <p class="footcredit">
        Développé par Kannann - <a href="https://k4ydigital.fr/">K4Y DIGITAL</a>
      </p>
    </div>
    <nav class="footlinks" aria-label="Liens de pied de page">
      {siteData.footer.legalLinks.map((link) => <a href={link.url}>{link.name}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: 30px 0;
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-text);
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
    flex-wrap: wrap;
  }
  .footbrand {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .footbrand img {
    /* fond blanc du JPG fondu dans le fond crème */
    mix-blend-mode: multiply;
    flex: 0 0 auto;
    display: block;
  }
  .footlinks {
    display: flex;
    gap: 8px 22px;
    flex-wrap: wrap;
  }
  .footlinks a {
    font-size: 14px;
    color: var(--color-muted);
    text-decoration: none;
    padding: 4px 0;
  }
  .footlinks a:hover {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footid {
    display: grid;
    gap: 10px;
  }
  .footcredit {
    margin: 0;
    padding-left: 78px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .footcredit a {
    color: inherit;
    font-weight: 700;
  }
</style>
