---
import { Image } from 'astro:assets';
import siteData from '../../data/site.json';
import logo from '../../assets/logo.jpg';
import { track, telHref } from '../../data/tracking.js';

const { phone, phoneDays, phoneHours, email } = siteData.contact.details;
const { addressLines } = siteData.permanences.locations[0];
// L'année du © se met à jour toute seule.
const copyright = siteData.footer.text.replace(/© \d{4}/, '© ' + new Date().getFullYear());
---

<footer class="site-footer">
  <div class="site-wrap footer-grid">
    <div class="foot-identity">
      <span class="logo-plate">
        <Image src={logo} width={96} height={48} densities={[1, 2]} format="webp" alt="Logo AFOC" />
      </span>
      <p class="foot-name">AFOC 34</p>
      <p class="foot-sub">Association Force Ouvrière Consommateurs de l'Hérault</p>
      <p class="foot-legal">{copyright}</p>
      <p class="foot-credit">
        Développé par Kannann - <a href="https://k4ydigital.fr/">K4Y DIGITAL</a>
      </p>
    </div>

    <div class="foot-contact">
      <h2 class="foot-title">Nous joindre</h2>
      <a class="foot-phone" href={telHref(phone)} {...track('telephone', 'pied')}>
        <span class="visually-hidden">Appeler le </span>{phone}
      </a>
      <p class="foot-hours">Par téléphone, {phoneDays}, {phoneHours}</p>
      <p class="foot-mail"><a href={`mailto:${email}`}>{email}</a></p>
      <address class="foot-address">
        {
          addressLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </address>
    </div>

    <nav class="foot-links" aria-label="Liens de pied de page">
      <h2 class="foot-title">Informations</h2>
      <ul>
        {
          siteData.footer.legalLinks.map((link) => (
            <li>
              <a href={link.url}>{link.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-ink);
    color: var(--color-foot-text);
    padding: 64px 0 56px;
    font-family: var(--font-text);
  }
  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: max(36px, calc((100% - 1220px) / 2));
    width: 46px;
    height: 3px;
    background: var(--color-coral-light);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 0.7fr);
    gap: 40px clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .logo-plate {
    display: inline-block;
    background: var(--color-white);
    padding: 8px 10px;
    margin-bottom: 22px;
    line-height: 0;
  }
  .foot-name {
    margin: 0 0 4px;
    font: 500 26px/1.15 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-white);
  }
  .foot-sub {
    margin: 0 0 22px;
    max-width: 340px;
    font-size: 15px;
    color: var(--color-foot-muted);
  }
  .foot-legal,
  .foot-credit {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-foot-muted);
  }
  .foot-legal {
    padding-top: 18px;
    border-top: 1px solid var(--color-foot-line);
    max-width: 380px;
  }
  .foot-title {
    margin: 0 0 16px;
    font: 700 12px/1.4 var(--font-text);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-coral-light);
  }
  .foot-phone {
    display: inline-block;
    font: 500 30px/1.15 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-decoration: none;
    border-bottom: 1px solid var(--color-foot-muted);
    padding-bottom: 2px;
  }
  .foot-phone:hover {
    border-color: var(--color-white);
  }
  .foot-hours {
    margin: 10px 0 20px;
    font-size: 14px;
    color: var(--color-foot-muted);
  }
  .foot-mail {
    margin: 0 0 14px;
    font-size: 15px;
  }
  .foot-address {
    font-style: normal;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-foot-muted);
  }
  a {
    color: inherit;
  }
  .foot-mail a,
  .foot-credit a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-foot-muted);
  }
  .foot-credit a {
    font-weight: 700;
    color: var(--color-white);
  }
  .foot-mail a:hover,
  .foot-credit a:hover {
    text-decoration-color: var(--color-white);
  }
  .foot-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-foot-line);
  }
  .foot-links li {
    border-bottom: 1px solid var(--color-foot-line);
  }
  .foot-links a {
    display: block;
    padding: 11px 0;
    font-size: 15px;
    color: var(--color-foot-text);
    text-decoration: none;
  }
  .foot-links a:hover {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* Focus lisible sur fond sombre */
  .site-footer :global(a:focus-visible) {
    outline-color: var(--color-coral-light);
  }
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot-identity {
      grid-column: 1 / -1;
    }
    .site-footer::before {
      left: 26px;
    }
  }
  @media (max-width: 720px) {
    .site-footer {
      padding: 48px 0 40px;
    }
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .site-footer::before {
      left: 20px;
    }
  }
</style>
