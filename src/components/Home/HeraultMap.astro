---
import { heraultMap } from '../../data/herault-map.js';

// Côté du libellé par rapport au point, choisi pour rester sur la terre et ne pas se chevaucher.
const labelSides = { Montpellier: 'left', Béziers: 'left', Sète: 'left' };
const [width, height] = heraultMap.viewBox;
const cities = Object.entries(heraultMap.cities).map(([name, position]) => ({
  name,
  side: labelSides[name] ?? 'left',
  ...position,
}));
---

<figure
  class="herault-map"
  role="img"
  aria-label="Carte de l'Hérault : permanences à Montpellier, Béziers et Sète"
>
  <div class="frame" style={`aspect-ratio: ${width} / ${height}`}>
    <svg viewBox={`0 0 ${width} ${height}`} aria-hidden="true" focusable="false">
      <path d={heraultMap.path} />
    </svg>
    {
      cities.map((city) => (
        <span
          class={`city city-${city.side}`}
          style={`left: ${city.xPct}%; top: ${city.yPct}%`}
          aria-hidden="true"
        >
          <i class="dot"></i>
          <span class="name">{city.name}</span>
        </span>
      ))
    }
  </div>
</figure>

<style>
  .herault-map {
    margin: 0;
  }
  .frame {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  path {
    fill: var(--color-pale);
    stroke: var(--color-teal);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .city {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    transform: translate(-6px, -50%);
    white-space: nowrap;
    font: 700 13px/1 var(--font-text);
    color: var(--color-ink);
  }
  .city-left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 6px), -50%);
  }
  .dot {
    flex: 0 0 auto;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-coral);
    border: 2px solid var(--color-surface);
  }
  .name {
    /* contour clair pour rester lisible par-dessus le tracé */
    paint-order: stroke fill;
    text-shadow:
      -1px -1px 0 var(--color-surface),
      1px -1px 0 var(--color-surface),
      -1px 1px 0 var(--color-surface),
      1px 1px 0 var(--color-surface);
  }
</style>
