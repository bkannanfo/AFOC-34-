---
import { track } from '../../data/tracking.js';

const issues = [
  { num: '01', href: '/logement-hlm', title: 'Charges, bail, état des lieux', tag: 'Vie locative & HLM' },
  { num: '02', href: '/consommation', title: 'Achat ou service litigieux', tag: 'Droits des consommateurs' },
  { num: '03', href: '/conseils', title: 'Une démarche à éclaircir', tag: 'Conseils & information' },
];
const towns = ['Montpellier', 'Béziers', 'Sète'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-mark" aria-hidden="true">34</div>
  <div class="site-wrap hero-grid">
    <div>
      <p class="eyebrow">Consommation · logement · Hérault</p>
      <h1 id="hero-title">Un souci de loyer,<br />de charges <em>ou d'achat&nbsp;?</em></h1>
      <p class="intro">
        Des bénévoles de l'AFOC 34 vous informent, vous conseillent et vous défendent, par téléphone
        ou en permanence à Montpellier, Béziers et Sète.
      </p>
      <div class="actions">
        <a class="button" href="/contact" {...track('contact', 'hero')}>
          Nous contacter <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#permanences">Voir les permanences <span aria-hidden="true">↓</span></a>
      </div>
      <div class="localproof">
        <span class="mark" aria-hidden="true">34</span>
        <span>
          <b>Un repère local pour vos questions du quotidien.</b><br />
          Association Force Ouvrière Consommateurs, agréée depuis 1975
        </span>
      </div>
    </div>

    <aside class="panel" aria-labelledby="panel-title">
      <div class="panel-top"><span>Logement &amp; consommation</span><span class="dot" aria-hidden="true"></span></div>
      <h2 id="panel-title">Par où commencer&nbsp;?</h2>
      <p class="panel-intro">Quelques sujets fréquents pour trouver la bonne porte d'entrée.</p>
      <ul class="issue-list">
        {
          issues.map((issue) => (
            <li>
              <a href={issue.href}>
                <span class="issue-num" aria-hidden="true">{issue.num}</span>
                <span>
                  <b>{issue.title}</b>
                  <small>{issue.tag}</small>
                </span>
                <span class="issue-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="panel-bottom">
        <span>Dans l'Hérault</span>
        <ul class="towns">{towns.map((town) => <li>{town}</li>)}</ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 84px 0 80px;
    background: var(--color-mist);
  }
  .hero-mark {
    position: absolute;
    right: -0.02em;
    top: -0.1em;
    font: 700 clamp(280px, 36vw, 480px) / 1 var(--font-display);
    letter-spacing: -0.1em;
    color: color-mix(in srgb, var(--color-teal) 5%, transparent);
    pointer-events: none;
    user-select: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
  }
  .eyebrow {
    margin: 0;
  }
  h1 {
    font: 500 clamp(44px, 6vw, 80px) / 1.02 var(--font-display);
    letter-spacing: -0.05em;
    max-width: 760px;
    margin: 22px 0;
  }
  h1 em {
    font-weight: 400;
    font-style: italic;
    color: var(--color-teal);
  }
  .intro {
    font-size: 18px;
    color: var(--color-ink-soft);
    max-width: 590px;
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 18px 26px;
    flex-wrap: wrap;
  }
  .localproof {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 38px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .localproof b {
    color: var(--color-ink);
    font-size: 15px;
  }
  .mark {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    color: var(--color-teal);
    font: italic 19px/1 var(--font-display);
    flex: 0 0 auto;
  }
  .panel {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    padding: 28px 28px 6px;
    box-shadow: 0 18px 44px color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .panel::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 28px;
    width: 46px;
    height: 3px;
    background: var(--color-coral);
  }
  .panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-muted);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .dot {
    width: 8px;
    height: 8px;
    background: var(--color-coral);
    border-radius: 50%;
  }
  .panel h2 {
    font: 500 clamp(28px, 3vw, 34px) / 1.1 var(--font-display);
    letter-spacing: -0.035em;
    margin: 18px 0 8px;
  }
  .panel-intro {
    font-size: 14px;
    color: var(--color-muted);
    margin: 0 0 12px;
  }
  .issue-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .issue-list a {
    display: grid;
    grid-template-columns: 30px 1fr 18px;
    align-items: center;
    gap: 10px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }
  .issue-list a:hover b {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .issue-num {
    font: italic 14px/1 var(--font-display);
    color: var(--color-coral);
  }
  .issue-list b {
    display: block;
    font-size: 16px;
    line-height: 1.4;
  }
  .issue-list small {
    display: block;
    font-size: 13px;
    color: var(--color-muted);
  }
  .issue-arrow {
    color: var(--color-coral);
    font-size: 15px;
  }
  .panel-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 0 18px;
    color: var(--color-muted);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .towns {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .towns li {
    border: 1px solid var(--color-line);
    padding: 4px 9px;
    color: var(--color-teal);
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding: 48px 0 44px;
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
    .actions .text-link {
      align-self: flex-start;
    }
    .panel {
      padding: 24px 20px 4px;
    }
    .panel-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .towns {
      justify-content: flex-start;
    }
  }
</style>
