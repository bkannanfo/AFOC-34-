---
import Arrow from '../UI/Arrow.astro';
// Pas d'articles affichés sur l'accueil pour l'instant (dernier article : 14/08/2026).
// À rétablir si l'AFOC publie régulièrement.
---

<section class="section" aria-labelledby="news-title">
  <div class="site-wrap">
    <div class="heading conseils">
      <div>
        <p class="eyebrow">Conseils</p>
        <h2 id="news-title">Des réponses à vos questions.</h2>
      </div>
      <p>
        Logement, charges, achats, démarchage : nos fiches et articles pour comprendre vos droits.<br />
        <a class="text-link" href="/conseils">Voir les conseils <Arrow dir="ne" /></a>
      </p>
    </div>
  </div>
</section>

<style>
  .conseils {
    margin-bottom: 0;
  }
  .text-link {
    margin-top: 10px;
  }
</style>
