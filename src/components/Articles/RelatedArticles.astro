---
import { getCollection } from 'astro:content';

// Props : collection ('logement' | 'consommation' | 'conseils'), currentId (identifiant de l'article affiché).
// Affiche jusqu'à 3 autres articles de la même rubrique, les plus récents d'abord.
const { collection, currentId } = Astro.props;

const articles = collection ? await getCollection(collection) : [];
const related = articles
  .filter((article) => article.id !== currentId)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const formatDate = (date) =>
  date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

{
  related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">À lire aussi</h2>
      <ul>
        {related.map((article) => (
          <li>
            <a href={`/${collection}/${article.id}`}>{article.data.title}</a>
            <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--color-line);
  }
  h2 {
    font: 500 26px/1.2 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  li {
    display: grid;
    gap: 2px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-line);
  }
  a {
    font: 500 20px/1.3 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-link-line);
    text-underline-offset: 4px;
  }
  a:hover {
    color: var(--color-teal);
    text-decoration-color: var(--color-coral);
  }
  time {
    font-size: 14px;
    color: var(--color-muted);
  }
</style>
