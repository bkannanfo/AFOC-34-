---
import Arrow from '../UI/Arrow.astro';
import { getCollection } from 'astro:content';
import PageHero from '../Page/PageHero.astro';
import ContactBand from '../Home/ContactBand.astro';
import GuidePratique from './GuidePratique.astro';

// Props : collection ('consommation' | 'logement' | 'conseils'), basePath, tag,
// heroLabel, heroTitle, heroSub.
const { collection, basePath, tag, heroLabel, heroTitle, heroSub } = Astro.props;

const articles = await getCollection(collection);
const sorted = articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const formatDate = (date) =>
  date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<PageHero eyebrow={heroLabel} title={heroTitle} intro={heroSub} />

<GuidePratique collection={collection} />

<section class="section" aria-labelledby="articles-title">
  <div class="site-wrap">
    <h2 id="articles-title" class="visually-hidden">Articles {tag}</h2>
    {
      sorted.length === 0 ? (
        <p class="empty">Aucun article publié pour le moment.</p>
      ) : (
        <ul class="news-grid">
          {sorted.map((article) => (
            <li class="news">
              <p class="news-tag">{tag}</p>
              <h3>
                <a href={`${basePath}/${article.id}`}>{article.data.title}</a>
              </h3>
              <p class="news-date">
                <time datetime={article.data.date.toISOString()}>
                  {formatDate(article.data.date)}
                </time>
              </p>
              {article.data.description && <p class="news-desc">{article.data.description}</p>}
              <span class="news-more" aria-hidden="true">
                Lire l'article <Arrow dir="ne" />
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<ContactBand />

<style>
  .news-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .news {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    padding: 24px 24px 22px;
  }
  .news:hover {
    border-color: var(--color-border-strong);
  }
  .news-tag {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-coral);
  }
  h3 {
    font: 500 22px/1.25 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }
  /* Toute la carte est cliquable via le lien du titre */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .news:hover h3 a {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .news:focus-within {
    outline: 3px solid var(--color-coral);
    outline-offset: 3px;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .news-date {
    margin: 0 0 12px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .news-desc {
    margin: 0 0 18px;
    font-size: 15px;
    color: var(--color-muted);
  }
  .news-more {
    margin-top: auto;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-teal);
  }
  .news-more span {
    color: var(--color-coral);
    padding-left: 6px;
  }
  .empty {
    font-size: 16px;
    color: var(--color-muted);
  }
  @media (max-width: 900px) {
    .news-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
