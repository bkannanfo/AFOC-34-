---
import Arrow from './Arrow.astro';
import siteData from '../../data/site.json';
import { track, telHref } from '../../data/tracking.js';
const { phone } = siteData.contact.details;
const { position = 'aide-juridique' } = Astro.props;
---

<aside class="aide" aria-labelledby="aide-title">
  <p class="aide-label">Réservé aux adhérents</p>
  <h2 id="aide-title">Besoin d'aide juridique&nbsp;?</h2>
  <p class="aide-intro">
    <strong>Si vous êtes adhérent de l'AFOC 34</strong>, contactez-nous :
  </p>
  <ul class="aide-list">
    <li>En vous rapprochant d'une AFOC départementale</li>
    <li>
      Par téléphone au <a href={telHref(phone)} {...track('telephone', position)}>{phone}</a>, du
      lundi au vendredi de 9h00 à 12h30 et de 13h30 à 17h00
    </li>
    <li>
      En saisissant votre litige sur <a href="https://sos.afoc.net/" target="_blank" rel="noopener"
        >SOS AFOC<span class="visually-hidden"> (nouvel onglet)</span></a
      >
    </li>
  </ul>
  <p class="aide-warning">
    Si vous n'êtes pas adhérent, l'AFOC ne peut légalement donner de consultations juridiques qu'à
    ses seuls membres.
  </p>
  <a class="text-link" href="/adhesion" {...track('adhesion', position)}>
    Adhérer <Arrow dir="ne" />
  </a>
</aside>

<style>
  .aide {
    position: relative;
    background: var(--color-sand);
    border: 1px solid var(--color-sand-line);
    padding: 28px 26px 26px;
  }
  .aide::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 26px;
    width: 46px;
    height: 3px;
    background: var(--color-coral);
  }
  .aide-label {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  h2 {
    font: 500 26px/1.15 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .aide-intro {
    font-size: 15px;
    color: var(--color-ink-soft);
    margin: 0 0 10px;
  }
  .aide-list {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    border-top: 1px solid var(--color-sand-line);
  }
  .aide-list li {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-sand-line);
    font-size: 15px;
    color: var(--color-ink-soft);
  }
  .aide-list a {
    color: var(--color-teal);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .aide-list a:hover {
    color: var(--color-coral);
  }
  .aide-warning {
    font-size: 14px;
    color: var(--color-muted);
    margin: 0 0 14px;
  }
</style>
