<form
  name="contact"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/merci-contact"
  class="form"
>
  <input type="hidden" name="form-name" value="contact" />
  <!-- Piège anti-robot : masqué pour tous (attribut hidden), ignoré des lecteurs d'écran et du clavier -->
  <p hidden aria-hidden="true">
    <label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <p class="form-help">Les champs marqués « obligatoire » doivent être remplis.</p>

  <div class="form-row">
    <div class="field">
      <label for="name">Nom complet <span class="req">(obligatoire)</span></label>
      <input type="text" id="name" name="name" required autocomplete="name" placeholder="Jean Dupont" />
    </div>
    <div class="field">
      <label for="email">Adresse e-mail <span class="req">(obligatoire)</span></label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="jean.dupont@email.com"
      />
    </div>
  </div>

  <div class="field">
    <label for="subject">Sujet du litige</label>
    <select id="subject" name="subject">
      <option value="logement">Litige Logement / HLM</option>
      <option value="consommation">Problème Consommation</option>
      <option value="banque">Banque / Assurance</option>
      <option value="autre">Autre demande</option>
    </select>
  </div>

  <div class="field">
    <label for="message">Votre message <span class="req">(obligatoire)</span></label>
    <textarea
      id="message"
      name="message"
      rows="6"
      required
      placeholder="Décrivez brièvement votre situation..."></textarea>
  </div>

  <div class="check">
    <input id="rgpd" name="rgpd_consent" type="checkbox" required />
    <label for="rgpd">
      J'accepte que mes données soient traitées par l'AFOC 34 dans le cadre de ma demande.
      <span class="req">(obligatoire)</span>
      {' '}<a href="/politique-confidentialite">Voir notre politique de confidentialité</a>.
    </label>
  </div>

  <button type="submit" class="button">Envoyer ma demande <span aria-hidden="true">↗</span></button>
</form>
