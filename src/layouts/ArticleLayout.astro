---
import Arrow from '../components/UI/Arrow.astro';
import Layout from './Layout.astro';
import ContactBand from '../components/Home/ContactBand.astro';

// Props : title, seoTitle?, description, seoDescription?, image?, tag, date, backHref.
const { title, seoTitle, description, seoDescription, image, tag, date, backHref } = Astro.props;

// Les images de couverture sont dans src/assets/articles et optimisées par Astro.
// Le frontmatter ne contient que le nom de fichier (ex. "incendie.jpg").
const articleImages = import.meta.glob('/src/assets/articles/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const cover = image ? articleImages[`/src/assets/articles/${image}`]?.default : undefined;
const formattedDate = date.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={seoTitle ?? title} description={seoDescription ?? description} image={cover?.src}>
  <article class="article">
    <header class="article-head">
      <div class="site-wrap article-wrap">
        <nav class="crumbs" aria-label="Fil d'Ariane">
          <ol>
            <li><a href="/">Accueil</a></li>
            <li><a href={backHref}>{tag}</a></li>
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
        <p class="eyebrow">{tag}</p>
        <h1>{title}</h1>
        <p class="article-date">Publié le <time datetime={date.toISOString()}>{formattedDate}</time></p>
        {description && <p class="article-lead">{description}</p>}
      </div>
    </header>

    <div class="site-wrap article-wrap article-main">
      <div class="article-body">
        <slot />
      </div>
      <p class="article-back">
        <a class="text-link" href={backHref}>
          <Arrow dir="left" class="arrow-before" /> Retour aux articles {tag}
        </a>
      </p>
    </div>
  </article>
  <ContactBand />
</Layout>

<style>
  .article-head {
    background: var(--color-mist);
    border-bottom: 1px solid var(--color-line);
    padding: 40px 0 44px;
  }
  .article-wrap {
    max-width: 780px;
  }
  .crumbs ol {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 10px;
    color: var(--color-border-strong);
  }
  .crumbs a {
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .crumbs a:hover {
    color: var(--color-teal);
  }
  .eyebrow {
    margin: 0;
  }
  h1 {
    font: 500 clamp(34px, 4.4vw, 52px) / 1.08 var(--font-display);
    letter-spacing: -0.04em;
    margin: 16px 0 14px;
  }
  .article-date {
    margin: 0;
    font-size: 14px;
    color: var(--color-muted);
  }
  .article-lead {
    margin: 18px 0 0;
    padding-left: 16px;
    border-left: 3px solid var(--color-coral);
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .article-main {
    padding: 44px 0 72px;
  }
  .article-body {
    font-size: 17px;
    line-height: 1.8;
    color: var(--color-ink-soft);
  }
  .article-body :global(h2) {
    font: 500 28px/1.2 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin: 44px 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-line);
  }
  .article-body :global(h3) {
    font: 500 22px/1.25 var(--font-display);
    color: var(--color-ink);
    margin: 32px 0 10px;
  }
  .article-body :global(p) {
    margin: 0 0 18px;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 22px;
    padding-left: 22px;
  }
  .article-body :global(li) {
    margin-bottom: 8px;
  }
  .article-body :global(li::marker) {
    color: var(--color-coral);
  }
  .article-body :global(strong) {
    color: var(--color-ink);
    font-weight: 700;
  }
  .article-body :global(a) {
    /* Une longue adresse web ne doit jamais faire déborder la page */
    overflow-wrap: anywhere;
    color: var(--color-teal);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-body :global(a:hover) {
    color: var(--color-coral);
  }
  .article-body :global(blockquote) {
    margin: 0 0 22px;
    padding: 18px 22px;
    background: var(--color-sand);
    border-left: 3px solid var(--color-coral);
  }
  .article-body :global(img) {
    max-width: 100%;
    height: auto;
  }
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 22px;
    font-size: 15px;
  }
  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid var(--color-line);
    padding: 8px 10px;
    text-align: left;
  }
  /* Pages d'un document (tract, affiche) affichées d'emblée dans l'article */
  .article-body :global(.doc-pages) {
    display: grid;
    gap: 32px;
    margin: 28px 0 12px;
  }
  .article-body :global(.doc-pages figure) {
    margin: 0;
  }
  .article-body :global(.doc-pages img) {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    margin-inline: auto;
    border: 1px solid var(--color-line);
    background: var(--color-pale);
  }
  .article-body :global(.doc-pages figcaption) {
    margin-top: 10px;
    text-align: center;
    font-size: 14px;
    color: var(--color-muted);
  }
  .article-back {
    margin: 48px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }
</style>
