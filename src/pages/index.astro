---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Home/Hero.astro';
import Permanences from '../components/Home/Permanences.astro';
import Missions from '../components/Home/Missions.astro';
import Engagement from '../components/Home/Engagement.astro';
import AdhesionBand from '../components/Home/AdhesionBand.astro';
import ConseilsTeaser from '../components/Home/ConseilsTeaser.astro';
import ContactBand from '../components/Home/ContactBand.astro';
import ElectionsPopup from '../components/Home/ElectionsPopup.astro';
import '../styles/refonte.css';

const title = 'AFOC 34 : consommateurs et locataires de l\'Hérault (Montpellier, Béziers, Sète)';
const description =
  "Association agréée, l'AFOC 34 informe, conseille et défend les consommateurs et locataires de l'Hérault. Permanences à Montpellier, Béziers et Sète.";
---

<Layout title={title} description={description} exactTitle>
  <div class="refonte">
    <Hero />
    <Permanences />
    <Missions />
    <Engagement />
    <AdhesionBand />
    <ConseilsTeaser />
    <ContactBand />
    <ElectionsPopup />
  </div>
</Layout>
