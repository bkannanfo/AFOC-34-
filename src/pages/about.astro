---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/Page/PageHero.astro';
import siteData from '../data/site.json';
import { track } from '../data/tracking.js';
import '../styles/refonte.css';

const { title, description, content } = siteData.about;
const { cta } = siteData.hero;
---

<Layout title={title} description={description}>
  <div class="refonte">
    <PageHero eyebrow="Qui sommes-nous" title={title} intro={description} />

    <section class="section" aria-label="Présentation de l'association">
      <div class="site-wrap">
        <div class="about-list">
          {
            content.map((section, index) => (
              <article class="about-item">
                <span class="about-num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h2>{section.sectionTitle}</h2>
                <p>{section.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="join" aria-labelledby="about-cta-title">
      <div class="site-wrap join-inner">
        <div>
          <p class="eyebrow">Nous joindre</p>
          <h2 id="about-cta-title">Besoin d'aide ou d'informations&nbsp;?</h2>
          <p class="join-text">
            L'AFOC 34 accompagne les consommateurs et les locataires dans leurs démarches, leurs
            litiges et la défense de leurs droits au quotidien.
          </p>
        </div>
        <a class="button button-light" href={cta.url} {...track('contact', 'about')}>
          {cta.label} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-list {
    border-top: 1px solid var(--color-line);
  }
  .about-item {
    display: grid;
    grid-template-columns: 40px minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: baseline;
    padding: 30px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .about-num {
    font: italic 16px/1 var(--font-display);
    color: var(--color-coral);
  }
  .about-item h2 {
    font: 500 clamp(26px, 2.6vw, 32px) / 1.15 var(--font-display);
    letter-spacing: -0.025em;
    margin: 0;
  }
  .about-item p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .join {
    background: var(--color-teal);
    color: var(--color-white);
    padding: 70px 0;
  }
  .join-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px 48px;
    flex-wrap: wrap;
  }
  .join .eyebrow {
    margin: 0;
    color: var(--color-on-teal);
  }
  .join .eyebrow::before {
    background: var(--color-coral-light);
  }
  .join h2 {
    font: 500 clamp(32px, 3.6vw, 44px) / 1.08 var(--font-display);
    letter-spacing: -0.04em;
    margin: 16px 0 14px;
    color: var(--color-white);
  }
  .join-text {
    font-size: 16px;
    color: var(--color-on-teal);
    max-width: 560px;
    margin: 0;
  }
  .button-light {
    background: var(--color-white);
    color: var(--color-teal) !important;
    border-color: var(--color-white);
  }
  .button-light:hover {
    background: var(--color-teal-tint);
  }
  @media (max-width: 900px) {
    .about-item {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 10px 16px;
    }
    .about-item p {
      grid-column: 2;
    }
  }
  @media (max-width: 560px) {
    .button-light {
      width: 100%;
      white-space: normal;
    }
  }
</style>
