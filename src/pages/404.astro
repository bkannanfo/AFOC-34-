---
import Layout from '../layouts/Layout.astro';
import MessagePage from '../components/Page/MessagePage.astro';
import { track } from '../data/tracking.js';
---

<Layout title="Page introuvable" noindex>
  <MessagePage eyebrow="Erreur 404" title="Page introuvable" mark="404">
    <p>La page que vous recherchez n'existe pas ou a été déplacée.</p>
    <a slot="actions" class="button" href="/">Retour à l'accueil</a>
    <a slot="actions" class="text-link" href="/contact" {...track('contact', '404')}>
      Nous contacter <span aria-hidden="true">↗</span>
    </a>
  </MessagePage>
</Layout>
