---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/Page/PageHero.astro';
import AideJuridique from '../components/UI/AideJuridique.astro';
import siteData from '../data/site.json';
import { iconPaths } from '../data/icons.js';
import { track } from '../data/tracking.js';
import '../styles/refonte.css';

const { services } = siteData;
---

<Layout
  title="Nos missions : logement, consommation, services publics"
  description="L'AFOC 34 défend les consommateurs et locataires de l'Hérault : litiges du logement, de la consommation et des services publics, et représentation en commission."
>
  <div class="refonte">
    <PageHero
      eyebrow="Ce que nous faisons"
      title="Nos missions"
      intro="Nous aidons nos adhérents à régler leurs litiges du quotidien, et nous siégeons dans les commissions où se discutent leurs droits, notamment dans le logement social."
    />

    <section class="section" aria-labelledby="domaines-title">
      <div class="site-wrap">
        <div class="heading">
          <div>
            <p class="eyebrow">Nos domaines</p>
            <h2 id="domaines-title">Sur quoi agir&nbsp;?</h2>
          </div>
        </div>
        <div class="mission-list">
          {
            services.map((service, index) => (
              <article class="mission">
                <span class="mission-num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="mission-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d={iconPaths[service.icon]} />
                  </svg>
                </span>
                <div class="mission-body">
                  <h3>{service.title}</h3>
                  <p>{service.desc}</p>
                </div>
                <div class="mission-actions">
                  <a class="text-link" href={service.href}>
                    Voir les articles<span class="visually-hidden"> : {service.title}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                  <a class="mission-help" href="/contact" {...track('contact', 'missions')}>
                    Besoin d'aide sur ce sujet ?
                    <span class="visually-hidden"> ({service.title})</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section aide-section">
      <div class="site-wrap aide-wrap">
        <AideJuridique position="missions" />
      </div>
    </section>
  </div>
</Layout>

<style>
  .mission-list {
    border-top: 1px solid var(--color-line);
  }
  .mission {
    display: grid;
    grid-template-columns: 40px 48px minmax(0, 1fr) auto;
    gap: 22px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .mission-num {
    font: italic 16px/1 var(--font-display);
    color: var(--color-coral);
  }
  .mission-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--color-teal);
    background: var(--color-icon-bg);
  }
  .mission-icon svg {
    width: 22px;
    height: 22px;
  }
  .mission h3 {
    font: 500 28px/1.15 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  .mission p {
    font-size: 16px;
    color: var(--color-muted);
    max-width: 620px;
    margin: 0;
  }
  .mission-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .mission-help {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-teal);
    text-decoration: none;
    border: 1px solid var(--color-border-strong);
    background: var(--color-white);
    padding: 10px 14px;
  }
  .mission-help:hover {
    background: var(--color-teal-tint);
    border-color: var(--color-teal);
  }
  .aide-section {
    padding-top: 0;
  }
  .aide-wrap {
    max-width: 860px;
  }
  @media (max-width: 900px) {
    .mission {
      grid-template-columns: 40px 48px minmax(0, 1fr);
    }
    .mission-actions {
      grid-column: 3;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }
  @media (max-width: 560px) {
    .mission {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 14px 16px;
    }
    .mission-num {
      display: none;
    }
    .mission-actions {
      grid-column: 1 / -1;
    }
  }
</style>
