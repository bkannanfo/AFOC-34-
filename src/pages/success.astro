---
import Layout from '../layouts/Layout.astro';
import MessagePage from '../components/Page/MessagePage.astro';
---

<Layout title="Merci pour votre adhésion" noindex>
  <MessagePage eyebrow="Demande reçue" title="Merci pour votre adhésion !">
    <p>
      Votre demande nous est bien parvenue. Un membre de l'AFOC 34 reviendra vers vous très
      rapidement pour finaliser votre adhésion.
    </p>
    <p>Merci de votre confiance, et à très bientôt.</p>
    <a slot="actions" class="button" href="/">Retour à l'accueil</a>
  </MessagePage>
</Layout>
