---
import Arrow from '../components/UI/Arrow.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/Page/PageHero.astro';
import siteData from '../data/site.json';
import { track, telHref } from '../data/tracking.js';

const { permanences } = siteData;
const { phone } = siteData.contact.details;

const mapUrlFor = (loc) =>
  'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent(`${loc.address}, ${loc.city}`);
---

<Layout
  title="Permanences à Montpellier, Béziers et Sète"
  description="Consultez les horaires et adresses des permanences de l'AFOC 34 à Montpellier, Béziers et Sète pour rencontrer un conseiller près de chez vous."
>
  <PageHero eyebrow="Près de chez vous" title={permanences.title} intro={permanences.description} />

  <section class="section" aria-label="Adresses et horaires">
    <div class="site-wrap">
      <div class="perm-grid">
        {
          permanences.locations.map((loc, index) => (
            <article class:list={['perm', index === 0 && 'main']}>
              <h2>{loc.city}</h2>
              <address>
                {loc.addressLines.map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))}
              </address>
              {loc.hours && (
                <ul class="hours">
                  {loc.hours.map((slot) => (
                    <li>
                      <b>{slot.days}</b>
                      <span>{slot.time}</span>
                    </li>
                  ))}
                </ul>
              )}
              <p class="perm-note">{loc.note}</p>
              {!loc.hours && (
                <a class="perm-call" href={telHref(phone)} {...track('telephone', 'permanences')}>
                  {phone}
                </a>
              )}
              <a class="text-link" href={mapUrlFor(loc)} target="_blank" rel="noopener noreferrer">
                Itinéraire vers {loc.city}
                <span class="visually-hidden"> (nouvel onglet)</span>
                <Arrow dir="ne" />
              </a>
            </article>
          ))
        }
      </div>

      <div class="perm-foot">
        <p>
          <strong>Important :</strong> les permanences peuvent être soumises à modification. Nous vous
          conseillons de nous contacter par téléphone au{' '}
          <a href={telHref(phone)} {...track('telephone', 'permanences')}>{phone}</a> avant de vous
          déplacer.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .perm-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .perm {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    padding: 28px 26px;
  }
  .perm.main {
    border-top: 3px solid var(--color-teal);
  }
  .perm h2 {
    font: 500 26px/1.15 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  address {
    font-style: normal;
    font-size: 15px;
    color: var(--color-ink-soft);
    margin-bottom: 16px;
  }
  .hours {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .hours li {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 15px;
  }
  .perm-note {
    font-size: 14px;
    color: var(--color-muted);
    margin: 0 0 18px;
  }
  .perm-call {
    align-self: flex-start;
    margin: -12px 0 18px;
    font-size: 16px;
    font-weight: 700;
    color: var(--color-teal);
    text-decoration: none;
    border-bottom: 1px solid var(--color-link-line);
  }
  .perm-call:hover {
    color: var(--color-coral);
    border-color: var(--color-coral);
  }
  .perm .text-link {
    margin-top: auto;
    align-self: flex-start;
    white-space: normal;
  }
  .perm-foot {
    margin-top: 18px;
    padding: 18px 22px;
    background: var(--color-sand);
    border: 1px solid var(--color-sand-line);
    font-size: 15px;
    color: var(--color-ink-soft);
  }
  .perm-foot p {
    margin: 0;
  }
  .perm-foot a {
    color: var(--color-teal);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 900px) {
    .perm-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
