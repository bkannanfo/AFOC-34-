---
import Arrow from '../components/UI/Arrow.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/Page/PageHero.astro';
import ContactForm from '../components/UI/ContactForm.astro';
import AideJuridique from '../components/UI/AideJuridique.astro';
import siteData from '../data/site.json';
import { track, telHref } from '../data/tracking.js';
import '../styles/refonte.css';

const contact = siteData.contact;
const { address, phone, phoneHours, email, access } = contact.details;
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(address);
---

<Layout
  title={contact.title}
  description="Contactez l'AFOC 34 par téléphone au 06 80 94 18 13, par courriel ou avec le formulaire en ligne. Siège : Maison des Syndicats à Montpellier."
>
  <div class="refonte">
    <PageHero eyebrow="Nous joindre" title={contact.title} intro={contact.description} />

    <section class="section">
      <div class="site-wrap contact-grid">
          <div class="call">
            <p class="call-label">Vous préférez appeler ?</p>
            <a class="call-phone" href={telHref(phone)} {...track('telephone', 'page-contact')}>
              {phone}
            </a>
            <p class="call-hours">Du lundi au vendredi, {phoneHours}.</p>
          </div>

          <div class="card card-accent form-card">
            <h2>Envoyer un message</h2>
            <ContactForm />
          </div>

          <div class="card siege">
            <h2>Notre siège</h2>
            <address>{address}</address>
            <p class="contact-line">
              <span>E-mail</span>
              <a href={`mailto:${email}`}>{email}</a>
            </p>
            <p class="contact-line">
              <span>Accès</span>
              {access}
            </p>
            <a class="text-link itinerary" href={mapUrl} target="_blank" rel="noopener noreferrer">
              Ouvrir l'itinéraire<span class="visually-hidden"> (nouvel onglet)</span>
              <Arrow dir="ne" />
            </a>
            <p class="map-note">
              L'itinéraire s'ouvrira directement dans votre application GPS (Google Maps, Waze, Apple
              Maps).
            </p>
          </div>
      </div>
    </section>

    <section class="section aide-section">
      <div class="site-wrap aide-wrap">
        <AideJuridique position="page-contact" />
      </div>
    </section>
  </div>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 16px clamp(24px, 4vw, 48px);
    grid-template-areas:
      'call form'
      'siege form';
    grid-template-rows: auto 1fr;
    align-items: start;
  }
  .call {
    grid-area: call;
  }
  .siege {
    grid-area: siege;
  }
  .form-card {
    grid-area: form;
  }
  .call {
    background: var(--color-teal);
    color: var(--color-white);
    padding: 28px 26px;
  }
  .call-label {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-teal);
  }
  .call-phone {
    display: inline-block;
    font: 700 clamp(28px, 3vw, 34px) / 1.2 var(--font-text);
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 45%, transparent);
  }
  .call-phone:hover {
    border-color: var(--color-white);
  }
  .call-hours {
    margin: 10px 0 0;
    font-size: 15px;
    color: var(--color-on-teal);
  }
  address {
    font-style: normal;
    font-size: 16px;
    color: var(--color-ink-soft);
    margin-bottom: 14px;
  }
  .contact-line {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--color-line);
    margin: 0;
  }
  .contact-line span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding-top: 3px;
  }
  .contact-line a {
    color: var(--color-teal);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .itinerary {
    margin-top: 16px;
  }
  .map-note {
    margin: 10px 0 0;
    font-size: 14px;
  }
  .form-card h2 {
    margin-bottom: 20px;
  }
  .aide-section {
    padding-top: 0;
  }
  .aide-wrap {
    max-width: 860px;
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'call' 'form' 'siege';
      grid-template-rows: none;
    }
  }
</style>
