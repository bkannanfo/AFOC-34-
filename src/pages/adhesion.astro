---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/Page/PageHero.astro';
import siteData from '../data/site.json';
import { track, telHref } from '../data/tracking.js';
import '../styles/refonte.css';

const { phone, phoneHours } = siteData.contact.details;
const benefits = [
  'Traitement prioritaire de vos litiges.',
  "Accès à nos dossiers d'expertise Logement & Consommation.",
  'Soutien à une association indépendante de défense des citoyens.',
];
---

<Layout
  title="Adhérer à l'AFOC 34"
  description="Rejoignez l'AFOC 34 pour défendre vos droits de consommateur et de locataire."
>
  <div class="refonte">
    <PageHero
      eyebrow="Rejoignez-nous"
      title="Adhésion AFOC 34"
      intro="Remplissez le formulaire ci-dessous : un membre de l'AFOC 34 vous recontacte."
    />

    <section class="section">
      <div class="site-wrap adhesion-grid">
        <div class="card card-accent">
          <form
            name="adhesion"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/success"
            class="form"
          >
            <input type="hidden" name="form-name" value="adhesion" />
            <!-- Piège anti-robot : champ sans libellé, masqué pour tous, hors clavier et lecteurs d'écran -->
            <p hidden aria-hidden="true">
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </p>

            <h2>Vos informations</h2>
            <p class="form-help">Les champs marqués « obligatoire » doivent être remplis.</p>

            <div class="form-row">
              <div class="field">
                <label for="firstname">Prénom <span class="req">(obligatoire)</span></label>
                <input type="text" id="firstname" name="firstname" required autocomplete="given-name" />
              </div>
              <div class="field">
                <label for="lastname">Nom <span class="req">(obligatoire)</span></label>
                <input type="text" id="lastname" name="lastname" required autocomplete="family-name" />
              </div>
            </div>

            <div class="form-row">
              <div class="field">
                <label for="adh-email">E-mail <span class="req">(obligatoire)</span></label>
                <input type="email" id="adh-email" name="email" required autocomplete="email" />
              </div>
              <div class="field">
                <label for="adh-phone">Téléphone</label>
                <input type="tel" id="adh-phone" name="phone" autocomplete="tel" />
              </div>
            </div>

            <div class="field">
              <label for="address">Adresse postale complète</label>
              <textarea id="address" name="address" rows="2" autocomplete="street-address"></textarea>
            </div>

            <div class="form-row">
              <div class="field">
                <label for="status">Votre situation</label>
                <select id="status" name="status">
                  <option value="" selected>Non précisé</option>
                  <option value="salarie">Salarié secteur privé/public</option>
                  <option value="retraite">Retraité</option>
                  <option value="etudiant">Étudiant / Lycéen</option>
                  <option value="sans-profession">Sans profession</option>
                  <option value="autre">Autre</option>
                </select>
              </div>
              <div class="field">
                <label for="housing">Votre logement</label>
                <select id="housing" name="housing">
                  <option value="" selected>Non précisé</option>
                  <option value="locataire-hlm">Locataire HLM</option>
                  <option value="locataire-prive">Locataire parc privé</option>
                  <option value="proprietaire">Propriétaire</option>
                </select>
              </div>
            </div>

            <div class="check">
              <input id="rgpd-adhesion" name="rgpd_consent" type="checkbox" required />
              <label for="rgpd-adhesion">
                J'accepte que mes données soient traitées par l'AFOC 34 dans le cadre de ma demande
                d'adhésion.
                <span class="req">(obligatoire)</span>
                {' '}<a href="/politique-confidentialite">Voir notre politique de confidentialité</a>.
              </label>
            </div>

            <button type="submit" class="button" data-umami-event="adhesion-envoi">
              Valider mon adhésion <span aria-hidden="true">↗</span>
            </button>
          </form>
        </div>

        <aside class="adhesion-aside">
          <div class="why">
            <h2>Pourquoi nous rejoindre ?</h2>
            <ul>{benefits.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div class="card">
            <p class="aside-label">Après l'envoi</p>
            <p class="aside-title">Nous revenons vers vous très rapidement.</p>
            <p>
              Remplissez le formulaire : un membre de l'AFOC 34 vous contacte après réception de votre
              demande.
            </p>
          </div>
          <div class="card">
            <p class="aside-label">Vous préférez appeler ?</p>
            <a class="aside-phone" href={telHref(phone)} {...track('telephone', 'adhesion')}>
              {phone}
            </a>
            <p class="aside-hours">Du lundi au vendredi, {phoneHours}.</p>
          </div>
        </aside>
      </div>
    </section>
  </div>
</Layout>

<style>
  .adhesion-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.85fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  .adhesion-aside {
    display: grid;
    gap: 16px;
  }
  .why {
    background: var(--color-teal);
    color: var(--color-white);
    padding: 28px 26px;
  }
  .why h2 {
    font: 500 26px/1.15 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    color: var(--color-white);
  }
  .why ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .why li {
    padding: 11px 0;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 25%, transparent);
    font-size: 16px;
  }
  .aside-label {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .aside-title {
    font: 500 24px/1.2 var(--font-display);
    color: var(--color-teal);
    margin: 0 0 8px;
  }
  .card p:last-child {
    margin-bottom: 0;
  }
  .aside-phone {
    display: inline-block;
    font: 700 24px/1.2 var(--font-text);
    color: var(--color-teal);
    text-decoration: none;
    border-bottom: 1px solid var(--color-link-line);
  }
  .aside-phone:hover {
    color: var(--color-coral);
    border-color: var(--color-coral);
  }
  .aside-hours {
    margin: 8px 0 0;
  }
  @media (max-width: 900px) {
    .adhesion-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
